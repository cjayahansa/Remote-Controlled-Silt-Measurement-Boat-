<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8" />
<title>Underwater Distance Mesher</title>
<style>
body {
    background: #0a0f14;
    color: white;
    font-family: Arial;
}
#connectBox {
    background: #111;
    padding: 12px;
    margin-bottom: 10px;
    border-radius: 8px;
}
canvas {
    background: #000;
    border: 1px solid #333;
    border-radius: 10px;
}
</style>
</head>
<body>

<div id="connectBox">
  <label>WebSocket URL:</label>
  <input id="wsUrl" value="ws://192.168.8.103:8080" style="width:250px;">
  <button onclick="connectWS()">Connect</button>
  <span id="status"></span>
</div>

<canvas id="mesh" width="600" height="600"></canvas>

<script>
let ws;
let ctx = document.getElementById("mesh").getContext("2d");

function connectWS() {
    const url = document.getElementById("wsUrl").value;
    ws = new WebSocket(url);

    ws.onopen = () => {
        document.getElementById("status").innerHTML = "🟢 Connected";
    };

    ws.onmessage = (msg) => {
        let data = JSON.parse(msg.data);
        drawMesh(data.distances);
    };

    ws.onclose = () => {
        document.getElementById("status").innerHTML = "🔴 Disconnected";
    };
}

function drawMesh(distances) {
    let w = 600, h = 600;
    ctx.clearRect(0, 0, w, h);
    ctx.translate(w/2, h/2);
    ctx.strokeStyle = "cyan";
    ctx.beginPath();

    for (let i = 0; i < distances.length; i++) {
        let a = (i - 90) * Math.PI / 180;
        let r = distances[i] * 10;  
        let x = r * Math.cos(a);
        let y = r * Math.sin(a);
        if (i == 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
    }

    ctx.stroke();
    ctx.setTransform(1, 0, 0, 1, 0, 0);
}
</script>

</body>
</html>

